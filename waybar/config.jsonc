{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 8,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": ["custom/launcher", "hyprland/workspaces", "custom/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/media",
        "group/audio-net",
        "cpu",
        "temperature",
        "memory",
        "disk",
        "battery",
        "tray"
    ],

    // ── Launcher ──────────────────────────────────────────────────────────────
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "hyprlauncher",
        "tooltip": false
    },

    // ── Workspaces ────────────────────────────────────────────────────────────
    "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"r-1\" }))'",
    "on-scroll-down": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"r+1\" }))'",
    "persistent-workspaces": {
        "*": 5
        }
    },

    // ── Window title ──────────────────────────────────────────────────────────
    "custom/window": {
        "exec": "~/.config/waybar/scripts/window.py",
        "return-type": "json",
        "restart-interval": 1,
        "format": "{}",
        "max-length": 50
    },

    // ── Clock ─────────────────────────────────────────────────────────────────
    "clock": {
        "interval": 1,
        "format": " {:%I:%M:%S %p}",
        "format-alt": "󰃭 {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#ffead3'><b>{}</b></span>",
                "days":     "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":    "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today":    "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },
    // ── Media player ──────────────────────────────────────────────────────────
    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "escape": true
    },

    // ── Audio + Network group ─────────────────────────────────────────────────
    "group/audio-net": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "network"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone":  "",
            "hands-free": "",
            "headset":    "",
            "phone":      "",
            "portable":   "",
            "car":        "",
            "default":    ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Sink: {desc}\nVolume: {volume}%"
    },

    "network": {
        "interval": 2,
        "format-wifi":        "󰤨 {bandwidthDownBytes} 󰤷  {bandwidthUpBytes} 󰤸",
        "format-ethernet":    "󰈀 {bandwidthDownBytes} 󰤷  {bandwidthUpBytes} 󰤸",
        "format-disconnected":"󰤭 No Network",
        "tooltip-format":          "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi":     "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "on-click": "nm-connection-editor"
    },

    // ── CPU ───────────────────────────────────────────────────────────────────
    "cpu": {
        "interval": 2,
        "format": "🎛 {usage}%",
        "format-alt": "🎛 {avg_frequency}GHz",
        "max-length": 20,
        "on-click": "kitty -e htop",
        "tooltip-format": "CPU Usage: {usage}%\nFreq: {avg_frequency}GHz"
    },

    // ── Temperature ───────────────────────────────────────────────────────────
"temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "interval": 4,
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-critical": "󰸁 {temperatureC}°C",
    "format-icons": ["","",""],
    "tooltip": true,
    "tooltip-format": "CPU Temp: {temperatureC}°C",
    "on-click": "kitty -e watch -n1 sensors"
},

    // ── Memory ────────────────────────────────────────────────────────────────
    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "format-alt": "󰍛 {used:0.1f}G/{total:0.1f}G",
        "max-length": 20,
        "on-click": "kitty -e htop",
        "tooltip-format": "RAM: {used:0.1f}G used / {total:0.1f}G total\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },

    // ── Disk ──────────────────────────────────────────────────────────────────
    "disk": {
        "interval": 30,
        "format": "󰋊 {free}",
        "path": "/",
        "tooltip-format": "Disk: {used} used / {total} total ({percentage_used}%)",
        "on-click": "baobab"
    },

    // ── Battery ───────────────────────────────────────────────────────────────
    "battery": {
        "states": {
            "good":     80,
            "warning":  30,
            "critical": 15
        },
        "format":          "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged":  "󰚥 {capacity}%",
        "format-alt":      "{icon} {time}",
        "format-icons":    ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format":  "Battery: {capacity}%\n{timeTo}"
    },

    // ── Tray ──────────────────────────────────────────────────────────────────
    "tray": {
        "icon-size": 18,
        "spacing": 10
    }
}
