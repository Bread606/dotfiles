{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "   ",
    "color": {
      "keys":  "blue",
      "title": "cyan"
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/hanoi_frames/frame0000.txt",
    "padding": {
        "top": 1,
        "left": 2
    }
},
  "modules": [ 
    {
      "type":   "title",
      "format":"{1}@{2}"
    },
    "separator",
    { "type": "os",      "key": "  OS",      "keyColor": "blue" },
    { "type": "kernel",  "key": "  Kernel",  "keyColor": "blue" },
    { "type": "wm",      "key": "  WM",      "keyColor": "blue" },
    { "type": "shell",   "key": "  Shell",   "keyColor": "blue" },
    { "type": "terminal","key": "  Term",    "keyColor": "blue" },
    "separator",
    { "type": "cpu",     "key": "  CPU",     "keyColor": "cyan" },
    { "type": "memory",  "key": "  RAM",     "keyColor": "cyan" },
    { "type": "disk",    "key": "  Disk",    "keyColor": "cyan",
      "folders": "/" },
    { "type": "uptime",  "key": "  Uptime",  "keyColor": "cyan" },
    "separator",
    { "type": "colors",  "paddingLeft": 2 },
    "break"
  ]
}
